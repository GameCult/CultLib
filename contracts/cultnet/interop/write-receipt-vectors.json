  "scenarios": {
    "windowMs": 500,
    "semantics": "Each scenario replays events in atMs order against a client that sent each write at its send event; a tick advances the clock without a frame. expect gives the settled outcome per write id. admitted/refused/unconfirmed are three distinct results; no scenario may settle admitted without a write_admitted frame carrying the write's id.",
    "cases": [
      {
        "name": "receipt_admits",
        "description": "A receipt with the id completes the write as admitted.",
        "server": "receipt",
        "writes": [
          "w1"
        ],
        "events": [
          {
            "atMs": 0,
            "send": "w1"
          },
          {
            "atMs": 5,
            "transportAck": "w1"
          },
          {
            "atMs": 20,
            "frame": {
              "schemaVersion": "cultnet.write_admitted.v0",
              "messageId": "w1",
              "operation": "put",
              "schemaId": "note.v0",
              "recordKey": "note:1"
            }
          }
        ],
        "expect": {
          "w1": {
            "outcome": "admitted"
          }
        }
      },
      {
        "name": "receipt_before_transport_ack",
        "description": "Order against the transport ack is irrelevant.",
        "server": "receipt",
        "writes": [
          "w1"
