              "operation": "put",
              "schemaId": "note.v0",
              "recordKey": "note:1"
            }
          },
          {
            "atMs": 9,
            "transportAck": "w1"
          }
        ],
        "expect": {
          "w1": {
            "outcome": "admitted"
          }
        }
      },
