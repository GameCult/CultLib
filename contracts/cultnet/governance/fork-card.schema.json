{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GameCult/CultLib/contracts/cultnet/governance/fork-card.schema.json",
  "title": "CultNet fork-desk contract v0",
  "description": "A fork card, the answer request a decider sends, the stored desk_answer with its tagged outcome, the result and door refusals returned to the sender, the record a fork keeps, and the ruling citation. Map-mode: every key is written, nil where absent. A request never carries answerer or authority: Huginn stamps both. Rule source: /opt/commons/handoff/fork-desk-answer-binding-20261110.md. Spec: fork-card.md. Vectors: fork-card-vectors.json.",
  "$defs": {
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?Z$"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "answerId": {
      "type": "string",
      "pattern": "^n[1-9][0-9]*$"
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "fork_id",
        "title",
        "context",
        "options",
        "recommendation",
        "depends",
        "leans",
        "flag",
        "raised_in",
        "deciders",
        "status",
        "ruling",
        "ruled_from",
        "order",
        "options_hash"
      ],
      "properties": {
        "schemaVersion": {
          "const": "gamecult.fork.card.v0"
        },
        "fork_id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        },
        "depends": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "leans": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "flag": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "raised_in": {
          "oneOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "deciders": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": [
            "open",
            "closed"
          ]
        },
        "ruling": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "ruled_from": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/answerId"
          }
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "options_hash": {
          "$ref": "#/$defs/hex64"
        }
      }
    },
    "words": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "^(?![\\t-\\r \\u0085   -     　]+$)[\\s\\S]+$"
    },
    "answerObject": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "choice",
            "note"
          ],
          "properties": {
            "choice": {
              "$ref": "#/$defs/id"
            },
            "note": {
              "$ref": "#/$defs/words"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "choice",
            "note"
          ],
          "properties": {
            "choice": {
              "$ref": "#/$defs/id"
            },
            "note": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "choice",
            "note"
          ],
          "properties": {
            "choice": {
              "type": "null"
            },
            "note": {
              "$ref": "#/$defs/words"
            }
          }
        }
      ]
    },
    "answerRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "fork_id",
        "options_hash",
        "answer",
        "retracted",
        "retracts",
        "answered_at"
      ],
      "properties": {
        "schemaVersion": {
          "const": "gamecult.fork.answer_request.v0"
        },
        "fork_id": {
          "$ref": "#/$defs/id"
        },
        "options_hash": {
          "$ref": "#/$defs/hex64"
        },
        "answer": {
          "oneOf": [
            {
              "$ref": "#/$defs/answerObject"
            },
            {
              "type": "null"
            }
          ]
        },
        "retracted": {
          "type": "boolean"
        },
        "retracts": {
          "oneOf": [
            {
              "$ref": "#/$defs/answerId"
            },
            {
              "type": "null"
            }
          ]
        },
        "answered_at": {
          "$ref": "#/$defs/instant"
        }
      }
    },
    "deskAnswerCounted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "answer_id",
        "fork_id",
        "outcome",
        "of",
        "retracts",
        "code",
        "options_hash",
        "choice",
        "note",
        "answered_at",
        "received_at",
        "claim_in_future",
        "answerer",
        "authority"
      ],
      "properties": {
        "schemaVersion": {
          "const": "gamecult.desk_answer.v0"
        },
        "answer_id": {
          "$ref": "#/$defs/answerId"
        },
        "fork_id": {
          "$ref": "#/$defs/id"
        },
        "outcome": {
          "const": "Counted"
        },
        "of": {
          "type": "null"
        },
        "retracts": {
          "type": "null"
        },
        "code": {
          "type": "null"
        },
        "options_hash": {
          "$ref": "#/$defs/hex64"
        },
        "choice": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "oneOf": [
            {
              "$ref": "#/$defs/words"
            },
            {
              "type": "null"
            }
          ]
        },
        "answered_at": {
          "$ref": "#/$defs/instant"
        },
        "received_at": {
          "$ref": "#/$defs/instant"
        },
        "claim_in_future": {
          "type": "boolean"
        },
        "answerer": {
          "$ref": "#/$defs/id"
        },
        "authority": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "deskAnswerRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "answer_id",
        "fork_id",
        "outcome",
        "of",
        "retracts",
        "code",
        "options_hash",
        "choice",
        "note",
        "answered_at",
        "received_at",
        "claim_in_future",
        "answerer",
        "authority"
      ],
      "properties": {
        "schemaVersion": {
          "const": "gamecult.desk_answer.v0"
        },
        "answer_id": {
          "$ref": "#/$defs/answerId"
        },
        "fork_id": {
          "$ref": "#/$defs/id"
        },
        "outcome": {
          "const": "Revision"
        },
        "of": {
          "$ref": "#/$defs/answerId"
        },
        "retracts": {
          "type": "null"
        },
        "code": {
          "type": "null"
        },
        "options_hash": {
          "$ref": "#/$defs/hex64"
        },
        "choice": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "oneOf": [
            {
              "$ref": "#/$defs/words"
            },
            {
              "type": "null"
            }
          ]
        },
        "answered_at": {
          "$ref": "#/$defs/instant"
        },
        "received_at": {
          "$ref": "#/$defs/instant"
        },
        "claim_in_future": {
          "type": "boolean"
        },
        "answerer": {
          "$ref": "#/$defs/id"
        },
        "authority": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "deskAnswerRetraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "answer_id",
        "fork_id",
        "outcome",
        "of",
        "retracts",
        "code",
        "options_hash",
        "choice",
        "note",
        "answered_at",
        "received_at",
        "claim_in_future",
        "answerer",
        "authority"
      ],
      "properties": {
        "schemaVersion": {
          "const": "gamecult.desk_answer.v0"
        },
        "answer_id": {
          "$ref": "#/$defs/answerId"
        },
        "fork_id": {
          "$ref": "#/$defs/id"
        },
        "outcome": {
          "const": "Retraction"
        },
        "of": {
          "type": "null"
        },
        "retracts": {
          "$ref": "#/$defs/answerId"
        },
        "code": {
          "type": "null"
        },
        "options_hash": {
          "$ref": "#/$defs/hex64"
        },
        "choice": {
          "type": "null"
        },
        "note": {
          "type": "null"
        },
        "answered_at": {
          "$ref": "#/$defs/instant"
        },
        "received_at": {
          "$ref": "#/$defs/instant"
        },
        "claim_in_future": {
          "type": "boolean"
        },
        "answerer": {
          "$ref": "#/$defs/id"
        },
        "authority": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "deskAnswerRefused": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "answer_id",
        "fork_id",
        "outcome",
        "of",
        "retracts",
        "code",
        "options_hash",
        "choice",
        "note",
        "answered_at",
        "received_at",
        "claim_in_future",
        "answerer",
        "authority"
      ],
      "properties": {
        "schemaVersion": {
          "const": "gamecult.desk_answer.v0"
        },
        "answer_id": {
          "$ref": "#/$defs/answerId"
        },
        "fork_id": {
          "$ref": "#/$defs/id"
        },
        "outcome": {
          "const": "Refused"
        },
        "of": {
          "type": "null"
        },
        "retracts": {
          "type": "null"
        },
        "code": {
          "enum": [
            "stale_fork",
            "not_a_decider",
            "fork_closed",
            "choice_invalid",
            "bad_retraction",
            "already_retracted"
          ]
        },
        "options_hash": {
          "$ref": "#/$defs/hex64"
        },
        "choice": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "oneOf": [
            {
              "$ref": "#/$defs/words"
            },
            {
              "type": "null"
            }
          ]
        },
        "answered_at": {
          "$ref": "#/$defs/instant"
        },
        "received_at": {
          "$ref": "#/$defs/instant"
        },
        "claim_in_future": {
          "type": "boolean"
        },
        "answerer": {
          "$ref": "#/$defs/id"
        },
        "authority": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "deskAnswer": {
      "oneOf": [
        {
          "$ref": "#/$defs/deskAnswerCounted"
        },
        {
          "$ref": "#/$defs/deskAnswerRevision"
        },
        {
          "$ref": "#/$defs/deskAnswerRetraction"
        },
        {
          "$ref": "#/$defs/deskAnswerRefused"
        }
      ]
    },
    "answerResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "answer",
        "card"
      ],
      "properties": {
        "schemaVersion": {
          "const": "gamecult.fork.answer_result.v0"
        },
        "answer": {
          "$ref": "#/$defs/deskAnswer"
        },
        "card": {
          "oneOf": [
            {
              "$ref": "#/$defs/card"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "code",
        "error"
      ],
      "properties": {
        "schemaVersion": {
          "const": "gamecult.fork.refusal.v0"
        },
        "code": {
          "enum": [
            "unauthenticated",
            "body_forbidden_field",
            "body_unknown_field",
            "body_invalid",
            "fork_unknown"
          ]
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "fork_id",
        "options_hash",
        "counted_answer_id",
        "answers"
      ],
      "properties": {
        "schemaVersion": {
          "const": "gamecult.fork.record.v0"
        },
        "fork_id": {
          "$ref": "#/$defs/id"
        },
        "options_hash": {
          "$ref": "#/$defs/hex64"
        },
        "counted_answer_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/answerId"
            },
            {
              "type": "null"
            }
          ]
        },
        "answers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deskAnswer"
          }
        }
      }
    },
    "rulingCite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "ruling_id",
        "authority",
        "answer_id"
      ],
      "properties": {
        "schemaVersion": {
          "const": "gamecult.fork.ruling_cite.v0"
        },
        "ruling_id": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "answer_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/answerId"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
