{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GameCult/CultLib/contracts/cultnet/cultnet.snapshot-request.v1.schema.json",
  "title": "CultNet Snapshot Request Message v1",
  "type": "object",
  "required": ["schemaVersion", "messageId", "selection"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "cultnet.snapshot_request.v1" },
    "messageId": { "type": "string", "minLength": 1 },
    "selection": { "$ref": "cultnet.selection.schema.json" },
    "shardId": { "type": "string", "minLength": 1 },
    "shardEpoch": { "type": "integer" }
  }
}
