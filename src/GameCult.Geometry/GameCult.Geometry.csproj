<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Spatial values, planetary geometry, queries, and typed geometry state built on CultMath primitives</Description>
    <PackageId>GameCult.Geometry</PackageId>
    <PackageTags>game;geometry;planetary;csg;lod;cultcache;cultmesh</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression></PackageLicenseExpression>
    <PackageLicenseFile>LICENSES.md</PackageLicenseFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <CultMathVersion>0.1.0-geometry-migration.2</CultMathVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameCult.Caching\GameCult.Caching.csproj" />
    <ProjectReference Include="..\GameCult.Caching.MessagePack\GameCult.Caching.MessagePack.csproj" />
    <PackageReference Include="CultMath" Version="$(CultMathVersion)" />
    <PackageReference Include="MessagePack" Version="3.1.7" />
    <PackageReference Include="System.Text.Json" Version="9.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSES.md" Pack="true" PackagePath="\" />
    <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
    <None Include="docs\planetary.md" Pack="true" PackagePath="docs\" />
    <None Include="Shaders\*.hlsl" Pack="true" PackagePath="contentFiles\any\any\shaders\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
