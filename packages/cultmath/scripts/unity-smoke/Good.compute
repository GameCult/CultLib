#pragma kernel CSMain
#include "Packages/org.gamecult.cultmath/Shaders/CultMath.hlsl"
#include "Packages/org.gamecult.cultmath/Shaders/CultMath.Interval.hlsl"
#include "Packages/org.gamecult.cultmath/Shaders/CultMath.Affine.hlsl"
RWStructuredBuffer<float4> Out;
[numthreads(1,1,1)] void CSMain(uint3 id : SV_DispatchThreadID)
{
    float2 r = cultmath_iv_add(float2(1, 2), float2(3, 5));
    float2 a = cultmath_af_range(cultmath_af_add(cultmath_af_point(3), cultmath_af_point(5)));
    Out[0] = float4(r, a);
}
