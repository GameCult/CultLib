{
  "name": "@gamecult/cultcache-ts",
  "version": "0.14.3",
  "description": "CultCache-style typed persistence for TypeScript with schema-backed polymorphic MessagePack storage.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./document": {
      "types": "./dist/document.d.ts",
      "require": "./dist/document.js",
      "default": "./dist/document.js"
    },
    "./inspection": {
      "types": "./dist/cult-cache-inspector.d.ts",
      "require": "./dist/cult-cache-inspector.js",
      "default": "./dist/cult-cache-inspector.js"
    }
  },
  "typesVersions": {
    "*": {
      "document": [
        "dist/document.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "prepack": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --pretty false",
    "test": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json && node ../../node_modules/typescript/bin/tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js"
  },
  "keywords": [
    "messagepack",
    "schema",
    "cache",
    "persistence",
    "zod",
    "typescript"
  ],
  "author": "metacratic",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GameCult/CultLib.git",
    "directory": "packages/cultcache-ts"
  },
  "bugs": {
    "url": "https://github.com/GameCult/CultLib/issues"
  },
  "homepage": "https://github.com/GameCult/CultLib/tree/main/packages/cultcache-ts#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "koffi": "3.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
