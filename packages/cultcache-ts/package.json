{
  "name": "cultcache-ts",
  "version": "0.13.5",
  "description": "CultCache-style typed persistence for TypeScript with schema-backed polymorphic MessagePack storage.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./inspection": {
      "types": "./dist/cult-cache-inspector.d.ts",
      "require": "./dist/cult-cache-inspector.js",
      "default": "./dist/cult-cache-inspector.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test dist-test/test/cult-cache.test.js"
  },
  "keywords": [
    "messagepack",
    "schema",
    "cache",
    "persistence",
    "zod",
    "typescript"
  ],
  "author": "metacratic",
  "license": "MIT",
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
