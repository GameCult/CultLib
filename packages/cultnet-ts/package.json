{
  "name": "cultnet-ts",
  "version": "0.2.0",
  "description": "CultNet-style typed direct-pipe messaging and state replication for TypeScript runtimes.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "require": "./dist/contracts.js",
      "default": "./dist/contracts.js"
    }
  },
  "files": [
    "dist",
    "contracts"
  ],
  "scripts": {
    "contracts:generate": "node tools/generate-swarm-contracts.mjs",
    "build": "node tools/generate-swarm-contracts.mjs && node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "prepack": "node tools/generate-swarm-contracts.mjs && node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "typecheck": "node tools/generate-swarm-contracts.mjs && node ../../node_modules/typescript/bin/tsc -p tsconfig.json --pretty false",
    "test": "node tools/generate-swarm-contracts.mjs && node ../../node_modules/typescript/bin/tsc -p tsconfig.json && node ../../node_modules/typescript/bin/tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "test:interop": "node tools/generate-swarm-contracts.mjs && node ../../node_modules/typescript/bin/tsc -p tsconfig.json && node ../../node_modules/typescript/bin/tsc -p tsconfig.test.json && node --test --test-force-exit dist-test/test/interop/*.test.js"
  },
  "keywords": [
    "messagepack",
    "networking",
    "pipes",
    "cultcache",
    "gamecult",
    "typescript"
  ],
  "author": "metacratic",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GameCult/CultLib.git",
    "directory": "packages/cultnet-ts"
  },
  "bugs": {
    "url": "https://github.com/GameCult/CultLib/issues"
  },
  "homepage": "https://github.com/GameCult/CultLib/tree/main/packages/cultnet-ts#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "ajv": "^8.17.1",
    "@gamecult/cultcache-ts": "^0.13.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.9.0",
    "zod": "^3.25.76"
  }
}
